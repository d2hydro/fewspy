# Copy this file to .env.development and fill in your credentials for local OAuth2 integration tests.
# This file is safe to commit because it only contains placeholders.

# FEWS endpoint to test against
FEWSPY_TEST_FEWS_URL=https://fewsapi.hhnk.nl/FewsWebServices/rest/fewspiservice/v1/

# Azure AD OAuth2 settings (client credentials)
FEWSPY_TEST_OAUTH2_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
FEWSPY_TEST_OAUTH2_CLIENT_ID=<client-id>
FEWSPY_TEST_OAUTH2_CLIENT_SECRET=<client-secret>
FEWSPY_TEST_OAUTH2_SCOPE=api://9905a90b-de6b-4251-a721-0acc7dadcd76/.default

# Optional: path to a PEM certificate file for token retrieval
# FEWSPY_TEST_OAUTH2_CERT=C:/path/to/client_cert.pem

# Optional: set to true to verify TLS certificates
# FEWSPY_TEST_OAUTH2_VERIFY=true

# Optional: use a temporary access token instead of requesting a new token.
# If true, FEWSPY_TEST_ACCESS_TOKEN is required and OAuth2 client credential vars are ignored by the integration test.
# FEWSPY_TEST_USE_TEMP_TOKEN=true
# FEWSPY_TEST_ACCESS_TOKEN=<bearer-token>
