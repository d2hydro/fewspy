# Copy this file to .env.development and fill in your credentials for local OAuth2 integration tests.
# This file is safe to commit because it only contains placeholders.

# FEWS endpoint to test against
FEWSPY_FEWS_URL=https://<mijn.domein.nl>/FewsWebServices/rest/fewspiservice/v1/
# Optional mTLS client certificate if the FEWS deployment explicitly requires one
# FEWSPY_FEWS_CERT=/path/to/fews-api-cert.pem
# Optional: set to false or a CA bundle path to change FEWS TLS verification
# FEWSPY_FEWS_VERIFY=true

# Azure AD OAuth2 settings (client credentials)
FEWSPY_OAUTH2_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
FEWSPY_OAUTH2_CLIENT_ID=<client-id>
FEWSPY_OAUTH2_CLIENT_SECRET=<client-secret>
FEWSPY_OAUTH2_SCOPE=api://<application-id>/.default
# Optional mTLS client certificate if the token endpoint explicitly requires one
# FEWSPY_OAUTH2_CERT=/path/to/token-endpoint-cert.pem

# Optional: set to false or a CA bundle path to change token endpoint TLS verification
# FEWSPY_OAUTH2_VERIFY=true

# Optional: use a temporary access token instead of requesting a new token.
# If true, FEWSPY_ACCESS_TOKEN is required and OAuth2 client credential vars are ignored by the integration test.
# FEWSPY_USE_TEMP_TOKEN=true
# FEWSPY_ACCESS_TOKEN=<bearer-token>
